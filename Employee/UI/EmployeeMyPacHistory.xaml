<Page x:Class="WPF_POLYCLINIC_DB_CourseWork.Employee.UI.EmployeeMyPacHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_POLYCLINIC_DB_CourseWork.Employee.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeeMyPacHistory">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Строка для заголовка -->
            <RowDefinition Height="Auto" />
            <!-- Строка для таблицы (занимает все свободное место) -->
            <RowDefinition />
            <!-- Строка для кнопок -->
            <RowDefinition Height="76" />
            <RowDefinition Height="2.72"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Label Content="История приемов и записей" 
           Grid.Row="0" 
           HorizontalAlignment="Center" 
           FontSize="16" FontWeight="Bold" Width="232"/>

        <!-- Таблица (убрали RowSpan) -->
        <DataGrid x:Name="dataGridMyPacHistory" 
              Grid.Row="1" 
              Margin="10,10,10,10"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                AutoGenerateColumns="True" 
                ColumnWidth="*"    />

        <!-- Контейнер для кнопки и комбобокса -->
        <StackPanel Grid.Row="2" 
                Orientation="Horizontal" 
                HorizontalAlignment="Left" 
                Margin="20,10,0,0" Width="241">

            <ComboBox x:Name="statusFilter" Width="156" 
                  VerticalAlignment="Center" 
                  Margin="5" Height="24"
                      SelectedIndex="1">
                <sys:String>Прошлые приёмы</sys:String>
                <sys:String>Актуальные приёмы</sys:String>
                <sys:String>Все приёмы</sys:String>
            </ComboBox>
            <Button Content="Выбрать" 
                Width="68" 
                Height="24" Click="Button_Click_1" 
                />

        </StackPanel>
        <Button x:Name="button_INPUT" Content="Осуществить приём" HorizontalAlignment="Right" Grid.Row="2" VerticalAlignment="Top" Height="24" Margin="0,31,10,0" Width="129" Click="Button_Click"/>
    </Grid>
</Page>
