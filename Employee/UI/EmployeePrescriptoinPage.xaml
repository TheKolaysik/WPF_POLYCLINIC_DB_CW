<Page x:Class="WPF_POLYCLINIC_DB_CourseWork.Employee.UI.EmployeePrescriptoinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_POLYCLINIC_DB_CourseWork.Employee.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeePrescriptoinPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Строка для заголовка -->
            <RowDefinition Height="Auto" />
            <!-- Строка для таблицы (занимает все свободное место) -->
            <RowDefinition />
            <!-- Строка для кнопок -->
            <RowDefinition Height="78.72" />
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Label Content="Выписанные рецепты" 
           Grid.Row="0" 
           HorizontalAlignment="Center" 
           FontSize="16" FontWeight="Bold" Width="232"/>

        <!-- Таблица (убрали RowSpan) -->
        <DataGrid x:Name="dataGridPrescriptions" 
              Grid.Row="1" 
              Margin="10,10,10,10"/>

        <!-- Контейнер для кнопки и комбобокса -->
        <Label Grid.Row="3" Margin="0,5,0,-5" HorizontalAlignment="Center" 
FontSize="16" FontWeight="Bold" Width="232"></Label>
        <Button x:Name="buttonPrescription" Content="Назначить лечение и выписать рецепт" HorizontalAlignment="Right" Grid.Row="2" VerticalAlignment="Top" Height="24" Margin="0,15,20,0" Width="250" Click="buttonPrescription_Click"/>
    </Grid>
</Page>
