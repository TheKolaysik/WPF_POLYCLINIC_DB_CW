<Page x:Class="WPF_POLYCLINIC_DB_CourseWork.Employee.UI.EmployeePrescriptoinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_POLYCLINIC_DB_CourseWork.Employee.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeePrescriptionPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Label Content="Выписанные рецепты" 
               Grid.Row="0" 
               HorizontalAlignment="Center" 
               FontSize="16" 
               FontWeight="Bold"/>

        <DataGrid x:Name="dataGridPrescriptions" 
                  Grid.Row="1" 
                  Margin="10"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  AutoGenerateColumns="True"
                  
                  IsReadOnly="True"
                  ColumnWidth="*">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <Button x:Name="buttonPrescription" 
                Content="Назначить лечение и выписать рецепт" 
                Grid.Row="2" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Height="30" 
                Width="260" 
                Margin="0,0,10,10" 
                Click="buttonPrescription_Click"/>
    </Grid>
</Page>