<Page x:Class="WPF_POLYCLINIC_DB_CourseWork.Employee.UI.PacientHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:local="clr-namespace:WPF_POLYCLINIC_DB_CourseWork.Employee.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PacientHistoryPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Строка для заголовка -->
            <RowDefinition Height="Auto" />
            <!-- Строка для таблицы (занимает все свободное место) -->
            <RowDefinition />
            <!-- Строка для кнопок -->
            <RowDefinition Height="78.72" />
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Label Content="История приемов и записей" 
           Grid.Row="0" 
           HorizontalAlignment="Center" 
           FontSize="16" FontWeight="Bold" Width="232"/>

        <!-- Таблица (убрали RowSpan) -->
        <DataGrid x:Name="dataGridMyHistory" 
              Grid.Row="1" 
              Margin="10,10,10,10"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        CanUserResizeRows="False"
        CanUserReorderColumns="False"
        CanUserResizeColumns="True"
        CanUserSortColumns="False"
        AutoGenerateColumns="True" 
        ColumnWidth="*"

/>

        <!-- Контейнер для кнопки и комбобокса -->
        <StackPanel Grid.Row="2" 
                Orientation="Horizontal" 
                HorizontalAlignment="Left" 
                Margin="20,10,0,0" Width="213">

            <ComboBox x:Name="statusFilter" Width="184" 
                  VerticalAlignment="Center" 
                  Margin="5" Height="24" SelectedIndex="2">
                <sys:String>Завершённые приёмы</sys:String>
                <sys:String>Предстоящие приёмы</sys:String>
                <sys:String>Все записи</sys:String>
            </ComboBox>

        </StackPanel>
        <Button Content="Запись на приём" HorizontalAlignment="Right" Grid.Row="2" Margin="0,32,10,23" Width="106" Click="Button_Click_1"/>
        <StackPanel Grid.Row="2" 
            Orientation="Horizontal" 
            Margin="260,10,0,0" Width="232" HorizontalAlignment="Left">
            <Button Content="Обновить" 
                Width="68" 
                Height="24" 
                Click="Button_Click" 
                />

        </StackPanel>
    </Grid>
</Page>
