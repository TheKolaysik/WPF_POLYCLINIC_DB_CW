<Page x:Class="WPF_POLYCLINIC_DB_CourseWork.Employee.UI.PacientPrescrittionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_POLYCLINIC_DB_CourseWork.Employee.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PacientPrescrittionPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Строка для заголовка -->
            <RowDefinition Height="Auto" />
            <!-- Строка для таблицы (занимает все свободное место) -->
            <RowDefinition />
            <!-- Строка для кнопок -->
            <RowDefinition Height="77" />
            <RowDefinition Height="1.72"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Label Content="Выписанные рецепты" 
           Grid.Row="0" 
           HorizontalAlignment="Center" 
           FontSize="16" FontWeight="Bold" Width="232"/>

        <!-- Таблица (убрали RowSpan) -->
        <DataGrid x:Name="dataGridMyPrescriptions" 
              Grid.Row="1" 
              Margin="10,10,10,10"
                      CanUserAddRows="False"
        CanUserDeleteRows="False"
        CanUserResizeRows="False"
        CanUserReorderColumns="False"
        CanUserResizeColumns="True"
        CanUserSortColumns="False"
        AutoGenerateColumns="True"
        IsReadOnly="True"
        ColumnWidth="*" >
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>   
                  

        <!-- Контейнер для кнопки и комбобокса -->
    </Grid>
</Page>
